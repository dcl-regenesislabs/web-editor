{
  "name": "@dcl-editor/service",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Private per-wallet project storage for the web editor: content-addressed files and a versioned manifest behind Decentraland signed fetch. Runs on Node 24 (filesystem) and Cloudflare Workers (R2).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/wallet.ts"
  },
  "scripts": {
    "dev": "node dev-server.ts",
    "session": "node scripts/session.ts",
    "typecheck": "tsc --noEmit",
    "image-login": "node scripts/image-login.ts"
  },
  "dependencies": {
    "@dcl/core-commons": "0.11.0",
    "@dcl/crypto": "^3.7.0",
    "@dcl/http-server": "2.4.0",
    "@dcl/metrics": "1.0.1",
    "@earendil-works/pi-ai": "1.0.1",
    "@earendil-works/pi-coding-agent": "1.0.1",
    "@well-known-components/env-config-provider": "1.2.0",
    "@well-known-components/interfaces": "1.5.2",
    "@well-known-components/logger": "3.1.3",
    "eth-connect": "^6.2.4",
    "undici": "8.11.2",
    "ws": "8.22.0",
    "@dcl-editor/mobile-preview": "0.1.0"
  },
  "devDependencies": {
    "@dcl/hashing": "^1.1.3",
    "@types/node": "^20.19.0",
    "@types/ws": "8.18.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
