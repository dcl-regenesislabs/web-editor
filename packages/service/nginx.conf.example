# Install in the nginx http context after replacing the hostname and certificate paths.
map $http_upgrade $editor_connection {
    default upgrade;
    '' close;
}
limit_req_zone $binary_remote_addr zone=editor_requests:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=editor_connections:10m;
# Upload tickets live in the query string; exclude queries and headers from access logs.
log_format editor_safe '$remote_addr $request_method $uri $status $body_bytes_sent';

server {
    listen 443 ssl;
    server_name service.example;
    ssl_certificate /etc/letsencrypt/live/service.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/service.example/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log /var/log/nginx/editor-access.log editor_safe;
    error_log /var/log/nginx/editor-error.log crit;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 50m;
    client_header_timeout 10s;
    client_body_timeout 30s;
    send_timeout 30s;
    limit_req_status 429;
    limit_conn_status 429;

    location = /metrics { return 404; }

    location / {
        limit_req zone=editor_requests burst=30 nodelay;
        limit_conn editor_connections 20;
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # the service trusts this only from a private peer (CLIENT_IP_HEADER=x-real-ip)
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $editor_connection;
        proxy_request_buffering off;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }
}
